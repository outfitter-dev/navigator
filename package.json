{
	"name": "navigator",
	"private": true,
	"workspaces": ["packages/*"],
	"scripts": {
		"dev": "bun run --filter @outfitter/navigator-server dev",
		"dev:mcp": "bun run --filter @outfitter/navigator-mcp dev",
		"build": "tsc --build && bun run build:bundle",
		"build:bundle": "bun run --filter @outfitter/navigator-server build:bundle && bun run --filter @outfitter/navigator-cli build:bundle && bun run --filter @outfitter/navigator-mcp build:bundle && bun run --filter @outfitter/navigator-extension build",
		"typecheck": "tsc --build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test",
		"test:cli": "./.claude/scripts/run-tests.sh --all",
		"test:mcp": "./.claude/scripts/run-mcp-tests.sh --all",
		"clean": "rm -rf packages/*/dist .scratch/testing",
		"clean:test": "rm -rf .scratch/testing"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.7.2"
	}
}

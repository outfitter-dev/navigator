{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"paths": {
			"@outfitter/navigator-core": ["../core/src"],
			"@outfitter/navigator-core/*": ["../core/src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"],
	"references": [{ "path": "../core" }]
}
